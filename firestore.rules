rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'buildolive4@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidGalleryImage(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 600)) &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.imageUrl is string && data.imageUrl.size() >= 8 && data.imageUrl.size() <= 1000 &&
             data.imageUrl.matches('^https://.*') &&
             (!('thumbUrl' in data) || (data.thumbUrl is string && data.thumbUrl.size() <= 1000 && (data.thumbUrl.size() == 0 || data.thumbUrl.matches('^https://.*')))) &&
             (!('aspectRatio' in data) || (data.aspectRatio is number && data.aspectRatio >= 0.3 && data.aspectRatio <= 3.5)) &&
             (!('price' in data) || (data.price is string && data.price.size() <= 32)) &&
             (!('isHidden' in data) || data.isHidden is bool) &&
             (!('refreshEpochMs' in data) || (data.refreshEpochMs is number && data.refreshEpochMs >= 0)) &&
             data.status is string && (data.status == 'published' || data.status == 'archived') &&
             data.featured is bool &&
             data.uploadedBy is string && data.uploadedBy.size() >= 1 && data.uploadedBy.size() <= 128 &&
             data.uploaderName is string && data.uploaderName.size() >= 1 && data.uploaderName.size() <= 80 &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 32)))) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /gallery_images/{imageId} {
      // Published gallery items are visible in the User Panel without requiring sign-up;
      // archived/draft items and all writes remain strictly Admin-only.
      allow get: if isValidId(imageId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(imageId) &&
                       isValidGalleryImage(incoming()) &&
                       isAdmin() &&
                       incoming().uploadedBy == request.auth.uid &&
                       incoming().keys().hasAll([
                         'title', 'category', 'imageUrl', 'status', 'featured',
                         'uploadedBy', 'uploaderName', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'description', 'category', 'imageUrl', 'thumbUrl',
                         'aspectRatio', 'price', 'isHidden', 'refreshEpochMs',
                         'status', 'featured', 'uploadedBy', 'uploaderName',
                         'tags', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(imageId) &&
                       isValidGalleryImage(incoming()) &&
                       isAdmin() &&
                       incoming().uploadedBy == existing().uploadedBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'description', 'category', 'imageUrl', 'thumbUrl',
                         'aspectRatio', 'price', 'isHidden', 'refreshEpochMs',
                         'status', 'featured', 'tags', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(imageId) && isAdmin();
    }
  }
}
