rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAccessCodeId(id) {
      return id is string && id.size() >= 4 && id.size() <= 24 && id.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidEmailDocId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.lower() == 'buildolive4@gmail.com';
    }

    function hasValidCodeAdmin(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid)) &&
             get(/databases/$(database)/documents/admins/$(uid)).data.codeUsed is string && (
               get(/databases/$(database)/documents/admins/$(uid)).data.codeUsed == 'PIN123456' ||
               (
                 isValidAccessCodeId(get(/databases/$(database)/documents/admins/$(uid)).data.codeUsed) &&
                 exists(/databases/$(database)/documents/admin_access_codes/$(get(/databases/$(database)/documents/admins/$(uid)).data.codeUsed)) &&
                 get(/databases/$(database)/documents/admin_access_codes/$(get(/databases/$(database)/documents/admins/$(uid)).data.codeUsed)).data.active == true
               )
             );
    }

    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email_verified == true && (
        request.auth.token.email.lower() == 'buildolive4@gmail.com' ||
        exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email.lower())) ||
        hasValidCodeAdmin(request.auth.uid)
      );
    }

    function isValidAdminMember(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 24 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.codeUsed is string && data.codeUsed.size() >= 4 && data.codeUsed.size() <= 24 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isUserBlockedOrSuspended() {
      return userDocExists(request.auth.uid) &&
             userDoc(request.auth.uid).moderationStatus in ['blocked', 'suspended'];
    }

    function isApprovedStaffUser() {
      return userDocExists(request.auth.uid) &&
             userDoc(request.auth.uid).staffStatus == 'approved' &&
             userDoc(request.auth.uid).moderationStatus == 'active';
    }

    function canStaffDirectChat() {
      return isApprovedStaffUser() &&
             (!('directChatEnabled' in userDoc(request.auth.uid)) ||
              userDoc(request.auth.uid).directChatEnabled == true);
    }

    function hasValidHttpsUrl(url) {
      return url is string && url.size() >= 8 && url.size() <= 1000 && url.matches('^https://.*');
    }

    function isValidCompanionProfile(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.age is int && data.age >= 18 && data.age <= 80 &&
             data.price is string && data.price.size() >= 1 && data.price.size() <= 32 &&
             data.role is string && data.role in ['GF', 'BF', 'Companion'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.tier is string && data.tier in ['vip_16_9', 'grid_9_16'] &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 600)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
             data.photoUrls is list && data.photoUrls.size() >= 1 && data.photoUrls.size() <= 8 &&
             hasValidHttpsUrl(data.photoUrls[0]) &&
             hasValidHttpsUrl(data.coverUrl) &&
             data.aspectRatio is number && data.aspectRatio >= 0.4 && data.aspectRatio <= 2.5 &&
             data.hiddenTimed is bool &&
             data.refreshEpochMs is number && data.refreshEpochMs >= 0 &&
             data.status is string && data.status in ['published', 'archived'] &&
             data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.staffVerified is bool &&
             (!('staffOnline' in data) || data.staffOnline is bool) &&
             (!('filterTags' in data) || (data.filterTags is list && data.filterTags.size() <= 24)) &&
             (!('advanceBookingAmount' in data) || (data.advanceBookingAmount is int && data.advanceBookingAmount >= 1 && data.advanceBookingAmount <= 500000)) &&
             (!('bookingPlans' in data) || (data.bookingPlans is list && data.bookingPlans.size() <= 12)) &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPrivateContact(data) {
      return data.phone is string && data.phone.size() <= 24 &&
             data.address is string && data.address.size() <= 240 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserAccount(data) {
      return data.name is string && data.name.size() <= 80 &&
             data.email is string && data.email.size() <= 120 &&
             data.photoUrl is string && data.photoUrl.size() <= 1000 &&
             (!('galleryUrls' in data) || (data.galleryUrls is list && data.galleryUrls.size() <= 6)) &&
             data.phone is string && data.phone.size() <= 24 &&
             data.age is int && data.age >= 0 && data.age <= 99 &&
             data.address is string && data.address.size() <= 240 &&
             (!('city' in data) || (data.city is string && data.city.size() <= 60)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 400)) &&
             (!('interests' in data) || (data.interests is string && data.interests.size() <= 160)) &&
             (!('genderPreference' in data) || (data.genderPreference is string && data.genderPreference.size() <= 32)) &&
             data.completionPercent is int && data.completionPercent >= 0 && data.completionPercent <= 100 &&
             data.online is bool &&
             data.lastActiveEpochMs is number && data.lastActiveEpochMs >= 0 &&
             data.hasInquiryNotification is bool &&
             data.leadTag is string && data.leadTag in ['none', 'hot', 'warm', 'cold'] &&
             data.moderationStatus is string && data.moderationStatus in ['active', 'blocked', 'suspended'] &&
             data.staffStatus is string && data.staffStatus in ['none', 'pending', 'approved', 'rejected'] &&
             (!('staffRole' in data) || (data.staffRole is string && data.staffRole.size() <= 20)) &&
             (!('staffPrice' in data) || (data.staffPrice is string && data.staffPrice.size() <= 32)) &&
             (!('staffTier' in data) || (data.staffTier is string && data.staffTier in ['grid_9_16', 'vip_16_9', ''])) &&
             (!('staffProfileId' in data) || (data.staffProfileId is string && data.staffProfileId.size() <= 128)) &&
             (!('directChatEnabled' in data) || data.directChatEnabled is bool) &&
             (!('staffOnline' in data) || data.staffOnline is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatThread(data) {
      return data.clientUid is string && data.clientUid.size() >= 1 && data.clientUid.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 80 &&
             (!('clientPhotoUrl' in data) || (data.clientPhotoUrl is string && data.clientPhotoUrl.size() <= 1000)) &&
             data.profileId is string && data.profileId.size() >= 1 && data.profileId.size() <= 128 &&
             data.profileName is string && data.profileName.size() >= 1 && data.profileName.size() <= 80 &&
             data.profilePhotoUrl is string && data.profilePhotoUrl.size() <= 1000 &&
             data.profilePrice is string && data.profilePrice.size() <= 32 &&
             data.staffOwnerUid is string && data.staffOwnerUid.size() <= 128 &&
             data.lastMessage is string && data.lastMessage.size() <= 500 &&
             data.lastSenderRole is string && data.lastSenderRole in ['client', 'staff', 'admin', ''] &&
             data.unreadForAdmin is int && data.unreadForAdmin >= 0 &&
             data.unreadForStaff is int && data.unreadForStaff >= 0 &&
             data.unreadForClient is int && data.unreadForClient >= 0 &&
             (!('clientLastReadEpochMs' in data) || (data.clientLastReadEpochMs is number && data.clientLastReadEpochMs >= 0)) &&
             (!('agentLastReadEpochMs' in data) || (data.agentLastReadEpochMs is number && data.agentLastReadEpochMs >= 0)) &&
             (!('clientLastDeliveredEpochMs' in data) || (data.clientLastDeliveredEpochMs is number && data.clientLastDeliveredEpochMs >= 0)) &&
             (!('agentLastDeliveredEpochMs' in data) || (data.agentLastDeliveredEpochMs is number && data.agentLastDeliveredEpochMs >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function hasNoContactLeak(text) {
      return !(text.lower().matches('.*([0-9][0-9\\s\\-\\.]{6,}[0-9]|@[a-z0-9_.]{2,}|instagram\\.com|insta\\s*id|whatsapp|telegram|snapchat|https?://).*'));
    }

    // Revocable transfer/access codes: ONLY Main Admin can create or delete!
    match /admin_access_codes/{codeId} {
      allow get: if isSignedIn() && isValidAccessCodeId(codeId);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
                       isValidAccessCodeId(codeId) &&
                       incoming().code == codeId &&
                       incoming().label is string && incoming().label.size() <= 60 &&
                       incoming().createdByEmail == request.auth.token.email.lower() &&
                       incoming().active == true &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().keys().hasAll(['code', 'label', 'createdByEmail', 'active', 'createdAt']) &&
                       incoming().keys().hasOnly(['code', 'label', 'createdByEmail', 'active', 'createdAt']);
      allow delete: if isSuperAdmin() && isValidAccessCodeId(codeId);
      allow update: if false;
    }

    // Admin member sessions (Name, Phone, Email + Code Used)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() &&
                       isValidId(adminUid) &&
                       request.auth.uid == adminUid &&
                       isValidAdminMember(incoming()) &&
                       (
                         isSuperAdmin() ||
                         incoming().codeUsed == 'PIN123456' ||
                         (
                           isValidAccessCodeId(incoming().codeUsed) &&
                           exists(/databases/$(database)/documents/admin_access_codes/$(incoming().codeUsed)) &&
                           get(/databases/$(database)/documents/admin_access_codes/$(incoming().codeUsed)).data.active == true
                         )
                       ) &&
                       incoming().keys().hasAll(['name', 'phone', 'email', 'codeUsed', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'phone', 'email', 'codeUsed', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() &&
                       isValidId(adminUid) &&
                       request.auth.uid == adminUid &&
                       isValidAdminMember(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isSuperAdmin() ||
                         incoming().codeUsed == 'PIN123456' ||
                         (
                           isValidAccessCodeId(incoming().codeUsed) &&
                           exists(/databases/$(database)/documents/admin_access_codes/$(incoming().codeUsed)) &&
                           get(/databases/$(database)/documents/admin_access_codes/$(incoming().codeUsed)).data.active == true
                         )
                       ) &&
                       incoming().keys().hasAll(['name', 'phone', 'email', 'codeUsed', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'phone', 'email', 'codeUsed', 'createdAt', 'updatedAt']);
      allow delete: if isSuperAdmin() || (isSignedIn() && isValidId(adminUid) && request.auth.uid == adminUid);
    }

    match /admin_emails/{emailId} {
      allow get: if isSignedIn() && isValidEmailDocId(emailId) && (
        (request.auth.token.email_verified == true && request.auth.token.email.lower() == emailId) ||
        isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isSuperAdmin() &&
                       isValidEmailDocId(emailId) &&
                       incoming().email is string &&
                       incoming().email.lower() == emailId &&
                       incoming().addedBy == request.auth.token.email.lower() &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().keys().hasAll(['email', 'addedBy', 'createdAt']) &&
                       incoming().keys().hasOnly(['email', 'addedBy', 'createdAt']);
      allow delete: if isSuperAdmin() && isValidEmailDocId(emailId);
      allow update: if false;
    }

    match /companion_profiles/{profileId} {
      allow get: if isValidId(profileId) && (isAdmin() || (resource != null && existing().status == 'published'));
      allow list: if resource.data.status == 'published' || isAdmin();

      allow create: if isSuperAdmin() &&
                       isValidId(profileId) &&
                       isValidCompanionProfile(incoming()) &&
                       incoming().createdByUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'name', 'age', 'price', 'role', 'category', 'tier',
                         'photoUrls', 'coverUrl', 'aspectRatio', 'hiddenTimed',
                         'refreshEpochMs', 'status', 'ownerUid', 'staffVerified',
                         'createdByUid', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'name', 'age', 'price', 'role', 'category', 'tier', 'bio', 'city',
                         'photoUrls', 'coverUrl', 'aspectRatio', 'hiddenTimed',
                         'refreshEpochMs', 'status', 'ownerUid', 'staffVerified', 'staffOnline',
                         'filterTags', 'advanceBookingAmount', 'bookingPlans',
                         'createdByUid', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(profileId) &&
                       isValidCompanionProfile(incoming()) &&
                       incoming().createdByUid == existing().createdByUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isSuperAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'name', 'age', 'price', 'role', 'category', 'tier', 'bio', 'city',
                            'photoUrls', 'coverUrl', 'aspectRatio', 'hiddenTimed',
                            'refreshEpochMs', 'status', 'ownerUid', 'staffVerified', 'staffOnline',
                            'filterTags', 'advanceBookingAmount', 'bookingPlans', 'updatedAt'
                          ])) ||
                         (isApprovedStaffUser() &&
                          existing().ownerUid != '' &&
                          existing().ownerUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'staffOnline', 'updatedAt'
                          ]))
                       );

      allow delete: if isSuperAdmin() && isValidId(profileId);

      match /private/{docId} {
        allow get, list: if isAdmin() && isValidId(profileId) && docId == 'contact';
        allow create, update: if isSuperAdmin() && isValidId(profileId) && docId == 'contact' && isValidPrivateContact(incoming());
        allow delete: if isSuperAdmin() && isValidId(profileId) && docId == 'contact';
      }
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserAccount(incoming()) &&
                       incoming().leadTag == 'none' &&
                       incoming().moderationStatus == 'active' &&
                       (incoming().staffStatus == 'none' || (incoming().staffStatus == 'pending' && incoming().age >= 18)) &&
                       (!('staffProfileId' in incoming()) || incoming().staffProfileId == '') &&
                       (!('directChatEnabled' in incoming()) || incoming().directChatEnabled == false) &&
                       (!('staffOnline' in incoming()) || incoming().staffOnline == false) &&
                       incoming().keys().hasAll([
                         'name', 'email', 'photoUrl', 'phone', 'age', 'address',
                         'completionPercent', 'online', 'lastActiveEpochMs',
                         'hasInquiryNotification', 'leadTag', 'moderationStatus',
                         'staffStatus', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'name', 'email', 'photoUrl', 'galleryUrls', 'phone', 'age', 'address',
                         'city', 'bio', 'interests', 'genderPreference', 'completionPercent',
                         'online', 'lastActiveEpochMs', 'hasInquiryNotification',
                         'leadTag', 'moderationStatus', 'staffStatus', 'staffRole',
                         'staffPrice', 'staffTier', 'staffProfileId', 'directChatEnabled', 'staffOnline',
                         'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserAccount(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isSuperAdmin() ||
                         (
                           request.auth.uid == userId &&
                           incoming().leadTag == existing().leadTag &&
                           incoming().moderationStatus == existing().moderationStatus &&
                           ((!('staffProfileId' in existing()) && !('staffProfileId' in incoming())) ||
                            ('staffProfileId' in existing() && 'staffProfileId' in incoming() && incoming().staffProfileId == existing().staffProfileId)) &&
                           ((!('directChatEnabled' in existing()) && !('directChatEnabled' in incoming())) ||
                            ('directChatEnabled' in existing() && 'directChatEnabled' in incoming() && incoming().directChatEnabled == existing().directChatEnabled)) &&
                           (!('staffOnline' in incoming()) || incoming().staffOnline == false || (existing().staffStatus == 'approved' && existing().moderationStatus == 'active')) &&
                           (
                             incoming().staffStatus == existing().staffStatus ||
                             (existing().staffStatus != 'approved' && incoming().staffStatus == 'pending' && incoming().age >= 18)
                           ) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'email', 'photoUrl', 'galleryUrls', 'phone', 'age', 'address',
                             'city', 'bio', 'interests', 'genderPreference', 'completionPercent',
                             'online', 'lastActiveEpochMs', 'hasInquiryNotification',
                             'staffStatus', 'staffRole', 'staffPrice', 'staffOnline', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (
        isAdmin() ||
        (resource == null &&
         chatId.size() > request.auth.uid.size() &&
         chatId[0:request.auth.uid.size() + 1] == (request.auth.uid + '_')) ||
        (resource != null && (
          existing().clientUid == request.auth.uid ||
          (existing().staffOwnerUid != '' && existing().staffOwnerUid == request.auth.uid)
        ))
      );
      allow list: if isSignedIn() && (
        resource.data.clientUid == request.auth.uid ||
        (resource.data.staffOwnerUid != '' && resource.data.staffOwnerUid == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(chatId) &&
                       isValidChatThread(incoming()) &&
                       (
                         isAdmin() ||
                         (incoming().clientUid == request.auth.uid && !isUserBlockedOrSuspended())
                       ) &&
                       incoming().keys().hasAll([
                         'clientUid', 'clientName', 'profileId', 'profileName',
                         'profilePhotoUrl', 'profilePrice', 'staffOwnerUid',
                         'lastMessage', 'lastSenderRole', 'unreadForAdmin',
                         'unreadForStaff', 'unreadForClient', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'clientUid', 'clientName', 'clientPhotoUrl', 'profileId', 'profileName',
                         'profilePhotoUrl', 'profilePrice', 'staffOwnerUid',
                         'lastMessage', 'lastSenderRole', 'unreadForAdmin',
                         'unreadForStaff', 'unreadForClient',
                         'clientLastReadEpochMs', 'agentLastReadEpochMs',
                         'clientLastDeliveredEpochMs', 'agentLastDeliveredEpochMs',
                         'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(chatId) &&
                       isValidChatThread(incoming()) &&
                       incoming().clientUid == existing().clientUid &&
                       incoming().profileId == existing().profileId &&
                       incoming().staffOwnerUid == existing().staffOwnerUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (existing().clientUid == request.auth.uid && !isUserBlockedOrSuspended()) ||
                         (existing().staffOwnerUid != '' && existing().staffOwnerUid == request.auth.uid && canStaffDirectChat())
                       ) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'clientName', 'clientPhotoUrl', 'profileName', 'profilePhotoUrl', 'profilePrice',
                         'lastMessage', 'lastSenderRole', 'unreadForAdmin', 'unreadForStaff', 'unreadForClient',
                         'clientLastReadEpochMs', 'agentLastReadEpochMs',
                         'clientLastDeliveredEpochMs', 'agentLastDeliveredEpochMs',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(chatId) && (
        isSuperAdmin() ||
        existing().clientUid == request.auth.uid ||
        (existing().staffOwnerUid != '' && existing().staffOwnerUid == request.auth.uid)
      );

      match /messages/{messageId} {
        function parentChatExists() {
          return exists(/databases/$(database)/documents/chats/$(chatId));
        }

        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow get, list: if isSignedIn() && isValidId(chatId) && parentChatExists() && (
          parentChat().clientUid == request.auth.uid ||
          (parentChat().staffOwnerUid != '' && parentChat().staffOwnerUid == request.auth.uid) ||
          isAdmin()
        );

        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         parentChatExists() &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().senderName is string && incoming().senderName.size() >= 1 && incoming().senderName.size() <= 80 &&
                         incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 1000 &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['senderUid', 'senderRole', 'senderName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['senderUid', 'senderRole', 'senderName', 'text', 'createdAt']) &&
                         (
                           (incoming().senderRole == 'admin' && isAdmin()) ||
                           (incoming().senderRole == 'staff' &&
                            parentChat().staffOwnerUid != '' &&
                            parentChat().staffOwnerUid == request.auth.uid &&
                            canStaffDirectChat() &&
                            hasNoContactLeak(incoming().text)) ||
                           (incoming().senderRole == 'client' &&
                            parentChat().clientUid == request.auth.uid &&
                            !isUserBlockedOrSuspended())
                         );

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && parentChatExists() && (
          isSuperAdmin() ||
          existing().senderUid == request.auth.uid ||
          parentChat().clientUid == request.auth.uid ||
          (parentChat().staffOwnerUid != '' && parentChat().staffOwnerUid == request.auth.uid)
        );
      }
    }

    function isValidPresence(data) {
      return data.online is bool &&
             data.lastSeenEpochMs is number && data.lastSeenEpochMs >= 0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /presence/{presenceId} {
      allow get, list: if isSignedIn() && isValidId(presenceId);
      allow create, update: if isSignedIn() &&
                               isValidId(presenceId) &&
                               (request.auth.uid == presenceId || (presenceId == 'admin_concierge' && isAdmin())) &&
                               isValidPresence(incoming()) &&
                               incoming().keys().hasAll(['online', 'lastSeenEpochMs', 'updatedAt']) &&
                               incoming().keys().hasOnly(['online', 'lastSeenEpochMs', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(presenceId);
    }

    function isValidLaunchBanner(data) {
      return data.active is bool &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             (!data.active || hasValidHttpsUrl(data.imageUrl)) &&
             data.title is string && data.title.size() <= 120 &&
             data.updatedByEmail is string && data.updatedByEmail.size() <= 120 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidHomeFilters(data) {
      return data.filters is list && data.filters.size() <= 24 &&
             data.updatedByEmail is string && data.updatedByEmail.size() <= 120 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFilterTaxonomy(data) {
      return data.groups is list && data.groups.size() <= 20 &&
             data.updatedByEmail is string && data.updatedByEmail.size() <= 120 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPaymentConfig(data) {
      return data.serverBaseUrl is string && data.serverBaseUrl.size() <= 300 &&
             (data.serverBaseUrl == '' || data.serverBaseUrl.matches('^https?://.*')) &&
             data.defaultAdvanceInr is int && data.defaultAdvanceInr >= 1 && data.defaultAdvanceInr <= 500000 &&
             data.updatedByEmail is string && data.updatedByEmail.size() <= 120 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidShareConfig(data) {
      return data.shareUrl is string && data.shareUrl.size() <= 500 &&
             (data.shareUrl == '' || data.shareUrl.matches('^https?://.*')) &&
             data.shareMessage is string && data.shareMessage.size() >= 2 && data.shareMessage.size() <= 500 &&
             data.updatedByEmail is string && data.updatedByEmail.size() <= 120 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAppUpdateConfig(data) {
      return data.latestVersionCode is int && data.latestVersionCode >= 1 && data.latestVersionCode <= 100000 &&
             data.latestVersionName is string && data.latestVersionName.size() >= 1 && data.latestVersionName.size() <= 32 &&
             data.apkDownloadUrl is string && data.apkDownloadUrl.size() <= 600 &&
             (data.apkDownloadUrl == '' || data.apkDownloadUrl.matches('^https?://.*')) &&
             data.releaseNotes is string && data.releaseNotes.size() <= 600 &&
             data.forceUpdate is bool &&
             data.updatedByEmail is string && data.updatedByEmail.size() <= 120 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPromoTickerConfig(data) {
      return data.active is bool &&
             data.badgeLabel is string && data.badgeLabel.size() >= 1 && data.badgeLabel.size() <= 32 &&
             data.text is string && data.text.size() <= 240 &&
             data.updatedByEmail is string && data.updatedByEmail.size() <= 120 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /app_config/{docId} {
      allow get: if docId in ['launch_banner', 'home_filters', 'filter_taxonomy', 'payment_config', 'share_config', 'app_update', 'promo_ticker'];
      allow list: if false;
      allow create, update: if isSuperAdmin() && (
        (
          docId == 'launch_banner' &&
          isValidLaunchBanner(incoming()) &&
          incoming().keys().hasAll(['active', 'imageUrl', 'title', 'updatedByEmail', 'updatedAt']) &&
          incoming().keys().hasOnly(['active', 'imageUrl', 'title', 'updatedByEmail', 'updatedAt'])
        ) || (
          docId == 'home_filters' &&
          isValidHomeFilters(incoming()) &&
          incoming().keys().hasAll(['filters', 'updatedByEmail', 'updatedAt']) &&
          incoming().keys().hasOnly(['filters', 'updatedByEmail', 'updatedAt'])
        ) || (
          docId == 'filter_taxonomy' &&
          isValidFilterTaxonomy(incoming()) &&
          incoming().keys().hasAll(['groups', 'updatedByEmail', 'updatedAt']) &&
          incoming().keys().hasOnly(['groups', 'updatedByEmail', 'updatedAt'])
        ) || (
          docId == 'payment_config' &&
          isValidPaymentConfig(incoming()) &&
          incoming().keys().hasAll(['serverBaseUrl', 'defaultAdvanceInr', 'updatedByEmail', 'updatedAt']) &&
          incoming().keys().hasOnly(['serverBaseUrl', 'defaultAdvanceInr', 'updatedByEmail', 'updatedAt'])
        ) || (
          docId == 'share_config' &&
          isValidShareConfig(incoming()) &&
          incoming().keys().hasAll(['shareUrl', 'shareMessage', 'updatedByEmail', 'updatedAt']) &&
          incoming().keys().hasOnly(['shareUrl', 'shareMessage', 'updatedByEmail', 'updatedAt'])
        ) || (
          docId == 'app_update' &&
          isValidAppUpdateConfig(incoming()) &&
          incoming().keys().hasAll(['latestVersionCode', 'latestVersionName', 'apkDownloadUrl', 'releaseNotes', 'forceUpdate', 'updatedByEmail', 'updatedAt']) &&
          incoming().keys().hasOnly(['latestVersionCode', 'latestVersionName', 'apkDownloadUrl', 'releaseNotes', 'forceUpdate', 'updatedByEmail', 'updatedAt'])
        ) || (
          docId == 'promo_ticker' &&
          isValidPromoTickerConfig(incoming()) &&
          incoming().keys().hasAll(['active', 'badgeLabel', 'text', 'updatedByEmail', 'updatedAt']) &&
          incoming().keys().hasOnly(['active', 'badgeLabel', 'text', 'updatedByEmail', 'updatedAt'])
        )
      );
      allow delete: if isSuperAdmin() && docId in ['launch_banner', 'home_filters', 'filter_taxonomy', 'payment_config', 'share_config', 'app_update', 'promo_ticker'];
    }

    function isValidBooking(data) {
      return data.clientUid is string && data.clientUid.size() >= 1 && data.clientUid.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 80 &&
             data.clientPhone is string && data.clientPhone.size() <= 24 &&
             data.clientPhotoUrl is string && data.clientPhotoUrl.size() <= 1000 &&
             data.profileId is string && data.profileId.size() >= 1 && data.profileId.size() <= 128 &&
             data.profileName is string && data.profileName.size() >= 1 && data.profileName.size() <= 80 &&
             data.profilePhotoUrl is string && data.profilePhotoUrl.size() <= 1000 &&
             data.staffOwnerUid is string && data.staffOwnerUid.size() <= 128 &&
             data.planLabel is string && data.planLabel.size() >= 1 && data.planLabel.size() <= 40 &&
             data.planPrice is string && data.planPrice.size() >= 1 && data.planPrice.size() <= 32 &&
             data.planNumericAmount is int && data.planNumericAmount >= 0 && data.planNumericAmount <= 500000 &&
             data.advanceAmountInr is int && data.advanceAmountInr >= 1 && data.advanceAmountInr <= 500000 &&
             data.advancePaid is bool &&
             data.paymentId is string && data.paymentId.size() <= 120 &&
             data.orderId is string && data.orderId.size() <= 120 &&
             data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 48 &&
             data.timeSlot is string && data.timeSlot.size() >= 1 && data.timeSlot.size() <= 48 &&
             data.meetingLocation is string && data.meetingLocation.size() >= 1 && data.meetingLocation.size() <= 240 &&
             data.notes is string && data.notes.size() <= 400 &&
             data.bookingStatus is string && data.bookingStatus in ['awaiting_payment', 'confirmed', 'awaiting_rating', 'completed', 'cancelled'] &&
             data.staffAttended is bool &&
             data.staffAttendedAtEpochMs is number && data.staffAttendedAtEpochMs >= 0 &&
             data.userRating is int && data.userRating >= 0 && data.userRating <= 5 &&
             data.userFeedback is string && data.userFeedback.size() <= 500 &&
             data.ratedAtEpochMs is number && data.ratedAtEpochMs >= 0 &&
             data.virtualEarningInr is int && data.virtualEarningInr >= 0 && data.virtualEarningInr <= 500000 &&
             data.payoutStatus is string && data.payoutStatus in ['pending', 'paid', 'rejected'] &&
             data.payoutNote is string && data.payoutNote.size() <= 240 &&
             data.payoutUpdatedByEmail is string && data.payoutUpdatedByEmail.size() <= 120 &&
             data.payoutUpdatedAtEpochMs is number && data.payoutUpdatedAtEpochMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && (
        isAdmin() ||
        (resource != null && (
          existing().clientUid == request.auth.uid ||
          (existing().staffOwnerUid != '' && existing().staffOwnerUid == request.auth.uid)
        ))
      );
      allow list: if isSignedIn() && (
        resource.data.clientUid == request.auth.uid ||
        (resource.data.staffOwnerUid != '' && resource.data.staffOwnerUid == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       !isUserBlockedOrSuspended() &&
                       isValidBooking(incoming()) &&
                       incoming().clientUid == request.auth.uid &&
                       incoming().bookingStatus == 'awaiting_payment' &&
                       incoming().advancePaid == false &&
                       incoming().staffAttended == false &&
                       incoming().userRating == 0 &&
                       incoming().payoutStatus == 'pending';

      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       isValidBooking(incoming()) &&
                       incoming().clientUid == existing().clientUid &&
                       incoming().profileId == existing().profileId &&
                       incoming().staffOwnerUid == existing().staffOwnerUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // ONLY Main Admin (Super Admin) can modify booking/payout records as admin!
                         (isSuperAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'bookingStatus', 'advancePaid', 'paymentId', 'orderId',
                            'staffAttended', 'staffAttendedAtEpochMs', 'virtualEarningInr',
                            'payoutStatus', 'payoutNote', 'payoutUpdatedByEmail', 'payoutUpdatedAtEpochMs',
                            'updatedAt'
                          ])) ||
                         // Client can confirm Chrome Razorpay payment OR submit post-date rating & feedback
                         (existing().clientUid == request.auth.uid &&
                          !isUserBlockedOrSuspended() &&
                          incoming().payoutStatus == existing().payoutStatus &&
                          incoming().staffAttended == existing().staffAttended &&
                          (
                            (existing().bookingStatus == 'awaiting_payment' &&
                             incoming().advancePaid == true &&
                             incoming().bookingStatus == 'confirmed' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'advancePaid', 'paymentId', 'orderId', 'bookingStatus', 'updatedAt'
                             ])) ||
                            (existing().staffAttended == true &&
                             incoming().userRating >= 1 && incoming().userRating <= 5 &&
                             incoming().bookingStatus == 'completed' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'userRating', 'userFeedback', 'ratedAtEpochMs', 'bookingStatus', 'virtualEarningInr', 'updatedAt'
                             ]))
                          )) ||
                         // Approved Staff can mark date as attended (triggers client rating notification)
                         (existing().staffOwnerUid != '' &&
                          existing().staffOwnerUid == request.auth.uid &&
                          isApprovedStaffUser() &&
                          existing().advancePaid == true &&
                          incoming().payoutStatus == existing().payoutStatus &&
                          incoming().staffAttended == true &&
                          incoming().bookingStatus == 'awaiting_rating' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'staffAttended', 'staffAttendedAtEpochMs', 'bookingStatus', 'updatedAt'
                          ]))
                       );

      allow delete: if isSuperAdmin() && isValidId(bookingId);
    }

    function isValidComplaint(data) {
      return data.userUid is string && data.userUid.size() >= 1 && data.userUid.size() <= 128 &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
             data.userEmail is string && data.userEmail.size() <= 120 &&
             data.userPhone is string && data.userPhone.size() <= 24 &&
             data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 120 &&
             data.message is string && data.message.size() >= 4 && data.message.size() <= 1000 &&
             data.status is string && data.status in ['open', 'resolved'] &&
             data.adminReply is string && data.adminReply.size() <= 600 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /complaints/{complaintId} {
      allow get: if isSignedIn() && isValidId(complaintId) && (
        isAdmin() || (resource != null && existing().userUid == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        resource.data.userUid == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() &&
                       isValidId(complaintId) &&
                       isValidComplaint(incoming()) &&
                       incoming().userUid == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().adminReply == '';
      allow update: if isSuperAdmin() &&
                       isValidId(complaintId) &&
                       isValidComplaint(incoming()) &&
                       incoming().userUid == existing().userUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'updatedAt']);
      allow delete: if isSuperAdmin() && isValidId(complaintId);
    }

    function isValidAdminChangeRequest(data) {
      return data.requesterUid is string && data.requesterUid.size() >= 1 && data.requesterUid.size() <= 128 &&
             data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 80 &&
             data.requesterEmail is string && data.requesterEmail.size() <= 120 &&
             data.requestType is string && data.requestType in ['profile_edit', 'new_profile', 'staff_access', 'price_or_filter', 'user_moderation', 'other'] &&
             data.targetId is string && data.targetId.size() <= 128 &&
             data.targetTitle is string && data.targetTitle.size() >= 1 && data.targetTitle.size() <= 100 &&
             data.details is string && data.details.size() >= 4 && data.details.size() <= 1000 &&
             data.status is string && data.status in ['pending', 'approved', 'rejected'] &&
             data.mainAdminNote is string && data.mainAdminNote.size() <= 500 &&
             data.reviewedByEmail is string && data.reviewedByEmail.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /admin_change_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        isSuperAdmin() ||
        (isAdmin() && resource != null && existing().requesterUid == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && resource.data.requesterUid == request.auth.uid)
      );
      allow create: if isAdmin() &&
                       isValidId(requestId) &&
                       isValidAdminChangeRequest(incoming()) &&
                       incoming().requesterUid == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().mainAdminNote == '' &&
                       incoming().reviewedByEmail == '' &&
                       incoming().keys().hasAll([
                         'requesterUid', 'requesterName', 'requesterEmail', 'requestType',
                         'targetId', 'targetTitle', 'details', 'status', 'mainAdminNote',
                         'reviewedByEmail', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'requesterUid', 'requesterName', 'requesterEmail', 'requestType',
                         'targetId', 'targetTitle', 'details', 'status', 'mainAdminNote',
                         'reviewedByEmail', 'createdAt', 'updatedAt'
                       ]);
      allow update: if isSuperAdmin() &&
                       isValidId(requestId) &&
                       isValidAdminChangeRequest(incoming()) &&
                       incoming().requesterUid == existing().requesterUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'mainAdminNote', 'reviewedByEmail', 'updatedAt'
                       ]);
      allow delete: if isSuperAdmin() && isValidId(requestId);
    }

    function isValidCallSession(data) {
      return data.callerUid is string && data.callerUid.size() >= 1 && data.callerUid.size() <= 128 &&
             data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 80 &&
             data.callerRole is string && data.callerRole in ['client', 'admin'] &&
             data.calleeUid is string && data.calleeUid.size() >= 1 && data.calleeUid.size() <= 128 &&
             data.calleeName is string && data.calleeName.size() >= 1 && data.calleeName.size() <= 80 &&
             data.chatId is string && data.chatId.size() <= 128 &&
             data.profileId is string && data.profileId.size() <= 128 &&
             data.profileName is string && data.profileName.size() <= 80 &&
             data.status is string && data.status in ['ringing', 'accepted', 'ended', 'declined', 'missed'] &&
             data.offerSdp is string && data.offerSdp.size() <= 20000 &&
             data.answerSdp is string && data.answerSdp.size() <= 20000 &&
             data.answeredByUid is string && data.answeredByUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isCallParticipant(data) {
      return isSignedIn() && (
        data.callerUid == request.auth.uid ||
        data.calleeUid == request.auth.uid ||
        (data.calleeUid == '__ADMIN__' && isAdmin()) ||
        (data.callerRole == 'admin' && isAdmin())
      );
    }

    match /call_sessions/{callId} {
      allow get: if isValidId(callId) && (isAdmin() || (resource != null && isCallParticipant(existing())));
      allow list: if isCallParticipant(resource.data);

      allow create: if isSignedIn() &&
                       isValidId(callId) &&
                       isValidCallSession(incoming()) &&
                       incoming().callerUid == request.auth.uid &&
                       incoming().status == 'ringing' &&
                       !isUserBlockedOrSuspended() &&
                       (incoming().callerRole == 'client' || isAdmin()) &&
                       incoming().keys().hasAll([
                         'callerUid', 'callerName', 'callerRole', 'calleeUid', 'calleeName',
                         'chatId', 'profileId', 'profileName', 'status',
                         'offerSdp', 'answerSdp', 'answeredByUid', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'callerUid', 'callerName', 'callerRole', 'calleeUid', 'calleeName',
                         'chatId', 'profileId', 'profileName', 'status',
                         'offerSdp', 'answerSdp', 'answeredByUid', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(callId) &&
                       isCallParticipant(existing()) &&
                       isValidCallSession(incoming()) &&
                       incoming().callerUid == existing().callerUid &&
                       incoming().callerRole == existing().callerRole &&
                       incoming().calleeUid == existing().calleeUid &&
                       incoming().chatId == existing().chatId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'offerSdp', 'answerSdp', 'answeredByUid', 'updatedAt'
                       ]);

      allow delete: if isAdmin() && isValidId(callId);

      match /{candidateCollection}/{candidateId} {
        function parentCall() {
          return get(/databases/$(database)/documents/call_sessions/$(callId)).data;
        }

        allow get, list: if isValidId(callId) &&
                             candidateCollection in ['offer_candidates', 'answer_candidates'] &&
                             isCallParticipant(parentCall());

        allow create: if isSignedIn() &&
                         isValidId(callId) &&
                         isValidId(candidateId) &&
                         candidateCollection in ['offer_candidates', 'answer_candidates'] &&
                         isCallParticipant(parentCall()) &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().sdpMid is string && incoming().sdpMid.size() <= 64 &&
                         incoming().sdpMLineIndex is int && incoming().sdpMLineIndex >= 0 &&
                         incoming().candidate is string && incoming().candidate.size() >= 1 && incoming().candidate.size() <= 2000 &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['senderUid', 'sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt']) &&
                         incoming().keys().hasOnly(['senderUid', 'sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt']);

        allow update, delete: if false;
      }
    }

    // Legacy gallery_images compatibility kept read-only for published docs & admin writes
    match /gallery_images/{imageId} {
      allow get: if isValidId(imageId) && (isAdmin() || (resource != null && existing().status == 'published'));
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
