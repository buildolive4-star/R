# IMGBB_API_KEY: Required for ImgBB image hosting API uploads (Admin Panel integration).
# AI Studio automatically injects this at runtime from user secrets.
# Configure your ImgBB API key via the Secrets panel in the AI Studio UI.
IMGBB_API_KEY=MY_IMGBB_API_KEY

# ONESIGNAL_APP_ID: Required for OneSignal Push Notifications (free tier, no card needed).
# Get from OneSignal Dashboard -> Settings -> Keys & IDs -> OneSignal App ID.
ONESIGNAL_APP_ID=MY_ONESIGNAL_APP_ID

# ONESIGNAL_REST_API_KEY: Required to send instant background/killed-app push alerts for chat, calls & profiles.
# Get from OneSignal Dashboard -> Settings -> Keys & IDs -> REST API Key (App API Key).
ONESIGNAL_REST_API_KEY=MY_ONESIGNAL_REST_API_KEY

