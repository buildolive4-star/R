{
  "entities": {
    "AdminEmail": {
      "title": "AdminEmail",
      "description": "Email granted Admin Studio access by the Super Admin without manual Firebase Console edits.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "addedBy", "createdAt"]
    },
    "CompanionProfile": {
      "title": "CompanionProfile",
      "description": "Public companion/staff profile published in VIP 16:9 carousel or 2-column 9:16 grid. Phone and address are isolated in private/contact.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "integer" },
        "price": { "type": "string" },
        "role": { "type": "string", "enum": ["GF", "BF", "Companion"] },
        "category": { "type": "string" },
        "tier": { "type": "string", "enum": ["vip_16_9", "grid_9_16"] },
        "bio": { "type": "string" },
        "photoUrls": { "type": "array" },
        "coverUrl": { "type": "string" },
        "aspectRatio": { "type": "number" },
        "hiddenTimed": { "type": "boolean" },
        "refreshEpochMs": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "archived"] },
        "ownerUid": { "type": "string" },
        "staffVerified": { "type": "boolean" },
        "staffOnline": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name", "age", "price", "role", "category", "tier",
        "photoUrls", "coverUrl", "aspectRatio", "hiddenTimed",
        "refreshEpochMs", "status", "ownerUid", "staffVerified",
        "createdByUid", "createdAt", "updatedAt"
      ]
    },
    "CompanionPrivateContact": {
      "title": "CompanionPrivateContact",
      "description": "Admin-only private contact record (phone & address) isolated from normal users.",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["phone", "address", "updatedAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "User profile, completion score, online presence, CRM lead tag, moderation status, and staff application state.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "galleryUrls": { "type": "array" },
        "phone": { "type": "string" },
        "age": { "type": "integer" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "bio": { "type": "string" },
        "interests": { "type": "string" },
        "genderPreference": { "type": "string" },
        "completionPercent": { "type": "integer" },
        "online": { "type": "boolean" },
        "lastActiveEpochMs": { "type": "number" },
        "hasInquiryNotification": { "type": "boolean" },
        "leadTag": { "type": "string", "enum": ["none", "hot", "warm", "cold"] },
        "moderationStatus": { "type": "string", "enum": ["active", "blocked", "suspended"] },
        "staffStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected"] },
        "staffRole": { "type": "string" },
        "staffPrice": { "type": "string" },
        "staffTier": { "type": "string" },
        "staffProfileId": { "type": "string" },
        "directChatEnabled": { "type": "boolean" },
        "staffOnline": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name", "email", "photoUrl", "phone", "age", "address",
        "completionPercent", "online", "lastActiveEpochMs", "hasInquiryNotification",
        "leadTag", "moderationStatus", "staffStatus", "createdAt", "updatedAt"
      ]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "1-on-1 inquiry thread between a client and a companion/staff profile, accessible by client, approved staff owner, and admins.",
      "type": "object",
      "properties": {
        "clientUid": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhotoUrl": { "type": "string" },
        "profileId": { "type": "string" },
        "profileName": { "type": "string" },
        "profilePhotoUrl": { "type": "string" },
        "profilePrice": { "type": "string" },
        "staffOwnerUid": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastSenderRole": { "type": "string" },
        "unreadForAdmin": { "type": "integer" },
        "unreadForStaff": { "type": "integer" },
        "unreadForClient": { "type": "integer" },
        "clientLastReadEpochMs": { "type": "number" },
        "agentLastReadEpochMs": { "type": "number" },
        "clientLastDeliveredEpochMs": { "type": "number" },
        "agentLastDeliveredEpochMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clientUid", "clientName", "profileId", "profileName",
        "profilePhotoUrl", "profilePrice", "staffOwnerUid",
        "lastMessage", "lastSenderRole", "unreadForAdmin",
        "unreadForStaff", "unreadForClient", "createdAt", "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat message inside a ChatThread with anti-contact guard for staff and participant deletion.",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["client", "staff", "admin"] },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "senderRole", "senderName", "text", "createdAt"]
    },
    "PresenceStatus": {
      "title": "PresenceStatus",
      "description": "Lightweight online/offline and last-seen indicator isolated from user PII.",
      "type": "object",
      "properties": {
        "online": { "type": "boolean" },
        "lastSeenEpochMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["online", "lastSeenEpochMs", "updatedAt"]
    },
    "LaunchBannerConfig": {
      "title": "LaunchBannerConfig",
      "description": "3-second launch promotional/info image overlay managed by Super Admin.",
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "imageUrl": { "type": "string" },
        "title": { "type": "string" },
        "updatedByEmail": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["active", "imageUrl", "title", "updatedByEmail", "updatedAt"]
    }
  },
  "firestore": {
    "/admin_emails/{emailId}": {
      "schema": { "$ref": "#/entities/AdminEmail" },
      "description": "Multi-admin email whitelist managed directly in-app by the Super Admin."
    },
    "/companion_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/CompanionProfile" },
      "description": "Public companion profiles visible on Home (VIP 16:9 carousel and 2x2 9:16 grid)."
    },
    "/companion_profiles/{profileId}/private/{docId}": {
      "schema": { "$ref": "#/entities/CompanionPrivateContact" },
      "description": "Isolated Admin-only private phone and address subcollection."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "User profile, lead tags, moderation flags, and staff verification records."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Inquiry chat metadata per client and companion profile."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside an inquiry chat thread."
    },
    "/presence/{presenceId}": {
      "schema": { "$ref": "#/entities/PresenceStatus" },
      "description": "Publicly queryable (signed-in) online/offline indicator without PII."
    },
    "/app_config/{docId}": {
      "schema": { "$ref": "#/entities/LaunchBannerConfig" },
      "description": "App-wide Super Admin launch info image configuration."
    }
  }
}
